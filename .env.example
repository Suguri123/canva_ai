# Canva Developer Portal 설정 (https://www.canva.com/developers)
# 1. Canva 개발자 포털에서 'Create an app' 또는 'Integrations' 생성
# 2. Redirect URL: http://localhost:8000/callback 등록
# 3. Scopes: asset:read asset:write brandtemplate:meta:read brandtemplate:content:read design:content:write design:meta:read

CANVA_CLIENT_ID=your_canva_client_id_here
CANVA_CLIENT_SECRET=your_canva_client_secret_here
CANVA_REDIRECT_URI=http://localhost:8000/callback

# (선택 사항) AI 자동 콘텐츠 생성을 위한 API 키 (Google Gemini 또는 OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 서버 설정
HOST=127.0.0.1
PORT=8000
